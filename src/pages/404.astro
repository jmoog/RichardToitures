---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site.js';
import { villes } from '../data/villes.js';

// Astro sert automatiquement cette page pour toute route inconnue, avec un
// vrai code HTTP 404 (adaptateur Node en mode standalone). Elle reste en
// noindex : une page d'erreur n'a rien à faire dans l'index de Google.
const path = '/404/';
const title = `Page introuvable — ${site.brand}`;
const description = `Cette page n’existe pas ou a été déplacée. Retrouvez les prestations de couverture, la demande de devis et les coordonnées de ${site.brand}.`;
---
<Layout title={title} description={description} path={path} noindex={true}>
  <section class="etat">
    <div class="container etat__inner">
      <p class="etat__code" aria-hidden="true">404</p>
      <h1>Cette page n’existe pas (ou plus)</h1>
      <p class="etat__lead">
        Le lien est peut-être erroné, ou la page a été déplacée depuis. Rien de grave&nbsp;:
        voici de quoi retrouver votre chemin en deux clics.
      </p>
      <div class="etat__actions">
        <a class="btn btn--rouge btn--lg" href="/">Retour à l’accueil</a>
        <a class="btn btn--lg etat__ghost btn--tel" href={`tel:${site.phoneHref}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z" /></svg>
          {site.phone}
        </a>
      </div>
      <p class="etat__note">
        Vous cherchiez à nous écrire&nbsp;? <a href="/devis-gratuit/">Demandez un devis gratuit</a>, la réponse est rapide.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Vous cherchiez peut-être&nbsp;…</h2>
        <p>Les prestations de {site.brand}, artisan couvreur en {site.address.region} ({site.address.department}).</p>
      </div>
      <div class="liens-proches">
        {services.map((s) => <a href={s.href}>{s.label}</a>)}
        <a href="/devis-gratuit/">Devis gratuit</a>
      </div>
    </div>
  </section>

  {villes.length > 0 && (
    <section class="section section--gris">
      <div class="container">
        <div class="section-head">
          <h2>Nos zones d’intervention</h2>
          <p>Couvreur-zingueur en {site.address.region}, déplacement et devis gratuits.</p>
        </div>
        <div class="liens-proches">
          {villes.map((v) => <a href={`/${v.slug}/`}>Couvreur à {v.name} ({v.postalCode})</a>)}
          <a href="/plan-du-site/">Plan du site</a>
        </div>
      </div>
    </section>
  )}
</Layout>
