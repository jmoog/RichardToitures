---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBand from '../components/TrustBand.astro';
import CtaBanner from '../components/CtaBanner.astro';
import NearbyLinks from '../components/NearbyLinks.astro';
import { site } from '../data/site.js';
import { villes, getVilleBySlug } from '../data/villes.js';
import { pageSchema } from '../data/schema.js';

export function getStaticPaths() {
  return villes.map((v) => ({ params: { slug: v.slug.replace('couvreur-', '') }, props: { ville: v } }));
}

const { ville } = Astro.props;
const path = `/${ville.slug}/`;
const breadcrumbLabel = `Couvreur à ${ville.name}`;
const nearbyLinks = (ville.nearby || []).map((slug) => {
  const v = getVilleBySlug(slug);
  return v ? { href: `/${v.slug}/`, label: `Couvreur à ${v.name}` } : null;
}).filter(Boolean);

// H1 : « à » et le nom de la commune sont liés par une espace insécable pour
// éviter un retour à la ligne qui isolerait le nom de la ville sur sa propre
// ligne (brief Joseph : pas de retour à la ligne sur un, deux ou trois mots).
const h1Text = ville.h1.replace(' à ', ' à ');

// Balisage : la zone desservie déclarée est la commune de la page, et elle
// seule (option `commune`) — une page ville qui revendiquerait les 13
// communes contredirait son propre contenu et diluerait le signal local.
const jsonLd = pageSchema(path, breadcrumbLabel, {
  pageName: ville.h1,
  description: ville.metaDescription,
  image: ville.heroPhoto?.src,
  commune: ville.name,
  service: {
    name: `Travaux de couverture à ${ville.name}`,
    type: 'Couverture, rénovation, réparation et entretien de toiture',
    description: `Entretien, réparation et rénovation de toiture à ${ville.name} (${ville.postalCode}) par ${site.founder}, artisan couvreur zingueur. Devis gratuit sous 24 h.`,
  },
});
---
<Layout title={ville.metaTitle} description={ville.metaDescription} path={path} jsonLd={jsonLd}>
  <Breadcrumb label={breadcrumbLabel} />

  <section class="page-hero">
    <div class="container">
      <h1>{h1Text}</h1>
      <p class="page-hero__artisan">{site.brand}</p>
      <div class="page-hero__grid">
        <div class="page-hero__text">
          {ville.intro.map((p) => <p set:html={p} />)}
          <ul class="page-hero__list">
            {ville.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <div class="actions">
            <a class="btn btn--rouge btn--tel" href={`tel:${site.phoneHref}`} aria-label={`Appeler le ${site.phone}`} title={`Appeler le ${site.phone}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.6" y="2" width="9.8" height="20" rx="2.9"></rect><line x1="8" y1="18.7" x2="11" y2="18.7"></line><path d="M17.9 8.9a4.6 4.6 0 0 1 0 6.2"></path><path d="M20.6 6.2a8.6 8.6 0 0 1 0 11.6"></path></svg>{site.phone}</a>
            <a class="btn btn--ghost" href="/devis-gratuit/" style="color:#fff;border-color:#fff">Demander un devis<span class="btn-menu__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9.1 5.6c2.6 1.4 4.6 3.6 5.8 6.4-1.2 2.8-3.2 5-5.8 6.4"></path></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9.1 5.6c2.6 1.4 4.6 3.6 5.8 6.4-1.2 2.8-3.2 5-5.8 6.4"></path></svg></span></a>
          </div>
        </div>
        <div class="page-hero__media">
          <img src={ville.heroPhoto.src} width={ville.heroPhoto.width} height={ville.heroPhoto.height} fetchpriority="high" decoding="async" alt={ville.heroPhoto.alt} />
        </div>
      </div>
    </div>
  </section>

  <TrustBand />

  <section class="section promo-section">
    <div class="section-head section-head--txt-left">
      <h2>{ville.servicesTitle}</h2>
    </div>
    <div class="promo-grid promo-grid--trio">
      {ville.cards.map((card) => (
        <a class="promo-card" href={card.href}>
          <h3>{card.title}</h3>
          <p>{card.text}</p>
          <img class="promo-card__icon" src={card.icon} width="512" height="512" loading="lazy" decoding="async" alt="" aria-hidden="true" />
          <span class="promo-card__brand"><span class="promo-card__more" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h11.5M12 6.5l5.5 5.5-5.5 5.5"></path></svg></span></span>
        </a>
      ))}
    </div>
  </section>

  <CtaBanner
    title={ville.cta.title}
    text={ville.cta.text}
    image={ville.cta.photo.src}
    imageAlt={ville.cta.photo.alt}
    ctaLabel={ville.cta.ctaLabel}
  />

  <section class="section section--gris">
    <div class="container">
      <div class="section-head section-head--left">
        <h2>{ville.longue.title}</h2>
      </div>
      <div class="longue-texte">
        {ville.longue.paragraphs.map((p) => <p set:html={p} />)}
        <aside class="encart-mairie">
          <p><strong>Avant vos travaux, renseignez-vous auprès des services de la mairie :</strong> pour une déclaration préalable ou toute question d'urbanisme, le plus simple est de contacter directement le service concerné.</p>
          <p class="encart-mairie__adresse">{ville.mairie.label} — {ville.mairie.address}</p>
          <p><a href={ville.mairie.url} target="_blank" rel="noopener">Consulter le site de la mairie de {ville.name}</a></p>
        </aside>
      </div>
    </div>
  </section>

  {nearbyLinks.length > 0 && (
    <NearbyLinks
      title={`${site.brand} intervient aussi autour de ${ville.name}`}
      text="Le déplacement reste gratuit dans les communes voisines — et dans tout le département."
      links={nearbyLinks}
      gris={false}
    />
  )}
</Layout>
