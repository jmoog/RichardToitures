---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TrustBand from '../components/TrustBand.astro';
import CtaBanner from '../components/CtaBanner.astro';
import NearbyLinks from '../components/NearbyLinks.astro';
import { site } from '../data/site.js';
import { villesNettoyage, getVilleNettoyageBySlug } from '../data/villesNettoyage.js';
import { pageSchema } from '../data/schema.js';

// Satellites du cocon nettoyage : /nettoyage-toiture-{ville}/, générés depuis
// src/data/villesNettoyage.js. Toujours moins profonds que le pilier
// /nettoyage-toiture-37/ (pas de tarifs détaillés, pas de FAQ).
export function getStaticPaths() {
  return villesNettoyage.map((v) => ({ params: { slug: v.slug.replace('nettoyage-toiture-', '') }, props: { ville: v } }));
}

const { ville } = Astro.props;
const path = `/${ville.slug}/`;
const breadcrumbLabel = `Nettoyage de toiture à ${ville.name}`;
const nearbyLinks = (ville.nearby || []).map((slug) => {
  const v = getVilleNettoyageBySlug(slug);
  return v ? { href: `/${v.slug}/`, label: `Nettoyage de toiture à ${v.name}` } : null;
}).filter(Boolean);

// Même règle que les pages couvreur : espace insécable entre « à » et le nom
// de la commune, pour ne jamais isoler la ville sur sa propre ligne.
const h1Text = ville.h1.replace(' à ', ' à ');

// Fil d'Ariane à 3 niveaux : le satellite est rattaché à son pilier. Le même
// `trail` alimente le fil affiché et le fil balisé, pour qu'ils coïncident.
const trail = [{ label: 'Nettoyage & démoussage', href: '/nettoyage-toiture-37/' }];

const jsonLd = pageSchema(path, breadcrumbLabel, {
  pageName: ville.h1,
  description: ville.metaDescription,
  image: ville.heroPhoto?.src,
  commune: ville.name,
  trail: trail.map((t) => ({ name: t.label, path: t.href })),
  service: {
    name: `Nettoyage de toiture à ${ville.name}`,
    type: 'Nettoyage, démoussage et traitement hydrofuge de toiture',
    description: `Démoussage, lavage basse pression et traitement hydrofuge des toitures à ${ville.name} par ${site.founder}, artisan couvreur en ${site.address.region}.`,
  },
});
---
<Layout title={ville.metaTitle} description={ville.metaDescription} path={path} jsonLd={jsonLd}>
  <Breadcrumb label={breadcrumbLabel} trail={trail} />

  <section class="page-hero">
    <div class="container">
      <h1>{h1Text}</h1>
      <p class="page-hero__artisan">{site.brand}</p>
      <div class="page-hero__grid">
        <div class="page-hero__text">
          {ville.intro.map((p) => <p set:html={p} />)}
          <ul class="page-hero__list">
            {ville.bullets.map((b) => <li>{b}</li>)}
          </ul>
          <div class="actions">
            <a class="btn btn--rouge btn--tel" href={`tel:${site.phoneHref}`} aria-label={`Appeler le ${site.phone}`} title={`Appeler le ${site.phone}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4.6" y="2" width="9.8" height="20" rx="2.9"></rect><line x1="8" y1="18.7" x2="11" y2="18.7"></line><path d="M17.9 8.9a4.6 4.6 0 0 1 0 6.2"></path><path d="M20.6 6.2a8.6 8.6 0 0 1 0 11.6"></path></svg>{site.phone}</a>
            <a class="btn btn--ghost" href="/devis-gratuit/" style="color:#fff;border-color:#fff">Demander un devis<span class="btn-menu__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9.1 5.6c2.6 1.4 4.6 3.6 5.8 6.4-1.2 2.8-3.2 5-5.8 6.4"></path></svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9.1 5.6c2.6 1.4 4.6 3.6 5.8 6.4-1.2 2.8-3.2 5-5.8 6.4"></path></svg></span></a>
          </div>
        </div>
        <div class="page-hero__media">
          <img src={ville.heroPhoto.src} width={ville.heroPhoto.width} height={ville.heroPhoto.height} fetchpriority="high" decoding="async" alt={ville.heroPhoto.alt} />
        </div>
      </div>
    </div>
  </section>

  <TrustBand />

  <section class="section">
    <div class="container">
      <div class="section-head section-head--left">
        <h2>{ville.sectionA.h2}</h2>
      </div>
      <div class="longue-texte">
        {ville.sectionA.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--gris">
    <div class="container media-split">
      <div class="media-split__text">
        <h2>{ville.sectionB.h2}</h2>
        {ville.sectionB.paragraphs.map((p) => <p set:html={p} />)}
      </div>
      <div class="media-split__media">
        <img src={ville.sectionB.photo.src} width={ville.sectionB.photo.width} height={ville.sectionB.photo.height} loading="lazy" decoding="async" alt={ville.sectionB.photo.alt} />
      </div>
    </div>
  </section>

  <CtaBanner
    title={ville.cta.title}
    text={ville.cta.text}
    image={ville.cta.photo.src}
    imageAlt={ville.cta.photo.alt}
    ctaLabel={ville.cta.ctaLabel}
  />

  <section class="section">
    <div class="container">
      <div class="section-head section-head--left">
        <h2>{ville.sectionC.h2}</h2>
      </div>
      <div class="longue-texte">
        {ville.sectionC.paragraphs.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--gris">
    <div class="container">
      <div class="section-head section-head--left">
        <h2>Comment se déroule l'intervention ?</h2>
      </div>
      <div class="features">
        {ville.etapes.map((e) => (
          <div class="feature">
            <h3>{e.h3}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {nearbyLinks.length > 0 && (
    <NearbyLinks
      title={`Nettoyage de toiture autour de ${ville.name}`}
      text="Le déplacement reste gratuit dans les communes voisines — et dans tout le département."
      links={nearbyLinks}
      gris={false}
    />
  )}
</Layout>
