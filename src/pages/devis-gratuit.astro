---
// Page entièrement statique : l'envoi passe par un appel fetch vers
// /api/devis/ (seule route dynamique du site). Même technique que le site
// de référence "eric-couvreur-94" : colonne de gauche éditoriale, formulaire
// en carte collante à droite, puis carte de la zone d'intervention.
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { site } from '../data/site.js';
import { pageSchema } from '../data/schema.js';

const path = '/devis-gratuit/';
// 58 caractères — requête « devis toiture / devis couvreur + Indre-et-Loire ».
const title = 'Devis Gratuit Toiture en Indre-et-Loire — Réponse sous 24 h';
// 151 caractères.
const description = `Devis gratuit et sans engagement pour vos travaux de toiture en ${site.address.region} : ${site.founder} se déplace, chiffre et répond sous 24 h ✓ ${site.phone}.`;

// Carte OpenStreetMap (sans cookie), centrée sur site.geo (Joué-lès-Tours).
// Affiner les coordonnées dans src/data/site.js si le marqueur doit tomber
// exactement sur l'adresse d'intervention.
const { lat, lng } = site.geo;
const d = 0.03;
const mapSrc = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - d}%2C${lat - d}%2C${lng + d}%2C${lat + d}&layer=mapnik&marker=${lat}%2C${lng}`;

// Clé publique Turnstile (variable de BUILD). Si vide, le formulaire marche
// quand même (le honeypot + le time-trap restent actifs).
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

// value = clé attendue par /api/devis (PRESTATION_LABELS) ; label = affichage
const prestationsOptions = [
  { v: 'couverture', l: 'Travaux de couverture' },
  { v: 'renovation', l: 'Rénovation de toiture' },
  { v: 'reparation', l: 'Réparation & recherche de fuites' },
  { v: 'nettoyage-demoussage', l: 'Nettoyage & démoussage' },
  { v: 'isolation-combles', l: 'Isolation des combles' },
  { v: 'ravalement', l: 'Ravalement de façade' },
  { v: 'ramonage', l: 'Ramonage' },
  { v: 'autre', l: 'Autre / à préciser' },
];
---
<Layout title={title} description={description} path={path} jsonLd={pageSchema(path, 'Devis gratuit', { pageName: `Demander un devis gratuit — ${site.brand}`, description })}>
  <Breadcrumb label="Devis gratuit" />

  <section class="section devis-top">
    <div class="container devis-grid">
      <div class="devis-intro">
        <h1>Devis gratuit pour vos travaux de toiture en {site.address.region}</h1>
        <p class="devis-lead">Un toit qui prend l'eau, une couverture fatiguée, des gouttières qui débordent : décrivez votre projet en deux minutes. Je vous rappelle, je viens voir le toit, et vous recevez un devis écrit sous 24 heures — gratuit et sans engagement.</p>

        <div class="devis-texte">
          <p>Un devis de toiture ne se rédige pas au téléphone. Vu du sol, un pan « juste à nettoyer » cache parfois des liteaux morts sous les tuiles ; à l'inverse, une infiltration inquiétante se règle souvent par une <a href="/reparation-toiture-37/">réparation de toiture</a> ciblée d'une demi-journée. Je me déplace donc systématiquement : je monte voir la couverture — au besoin depuis le panier de mon camion-nacelle, sans marcher sur les tuiles —, je passe dans les combles quand il y a une trace d'eau, et je chiffre sur ce que j'ai constaté, pas sur une estimation à distance.</p>
          <p>Vous recevez ensuite un devis détaillé poste par poste : les surfaces concernées, les matériaux et leur provenance, la dépose et l'évacuation des gravats, l'échafaudage ou la nacelle lorsqu'il en faut. Rien de forfaitaire ni de flou, pour que vous puissiez le comparer sereinement à un autre. Le déplacement et le conseil sont gratuits, le devis vous parvient sous 24 heures, et il ne vous engage à rien.</p>
          <p>Le formulaire accueille toutes les demandes, du remplacement de quelques tuiles à la <a href="/renovation-toiture-37/">rénovation d'une toiture</a> complète. Plus vous m'en direz — âge du toit, matériau, ce que vous avez constaté, une photo si vous en avez une —, plus mon premier retour sera précis. Et si l'eau entre déjà chez vous, ne passez pas par le formulaire : appelez le {site.phone}, j'interviens 24 h/24 pour mettre votre toit hors d'eau avant de chiffrer quoi que ce soit.</p>
        </div>

        <img class="devis-photo" src="/photos-chantier/renovation-toiture-ferme-nacelle-richard-toitures-39-1.webp" width="1600" height="777" loading="lazy" decoding="async" alt={`Camion-nacelle déployé au pied d'une ferme en pierre pour une réfection de toiture — ${site.brand}, couvreur en ${site.address.region}`} />
      </div>

      <aside class="devis-form-card">
        <h2>Votre devis gratuit</h2>
        <p class="devis-form-card__lead">Quelques informations pour vous rappeler avec un premier retour, sans engagement.</p>
        <form id="devis-form" class="devis-form" method="post" action="/api/devis/">
          <!-- Anti-spam : ne pas remplir -->
          <p class="hp" aria-hidden="true">
            <label>Ne pas remplir <input name="website" tabindex="-1" autocomplete="off" /></label>
          </p>

          <div class="field">
            <label for="nom">Nom et prénom *</label>
            <input type="text" id="nom" name="nom" autocomplete="name" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="tel">Téléphone *</label>
              <input type="tel" id="tel" name="tel" autocomplete="tel" required />
            </div>
            <div class="field">
              <label for="email">Email *</label>
              <input type="email" id="email" name="email" autocomplete="email" required />
            </div>
          </div>
          <div class="field">
            <label for="ville">Ville du chantier *</label>
            <input type="text" id="ville" name="ville" autocomplete="address-level2" required />
          </div>
          <div class="field">
            <label for="prestation">Type de travaux</label>
            <select id="prestation" name="prestation">
              <option value="">— Sélectionnez —</option>
              {prestationsOptions.map((p) => <option value={p.v}>{p.l}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="message">Votre projet *</label>
            <textarea id="message" name="message" rows="4" required></textarea>
          </div>

          {turnstileKey && (
            <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="light" style="margin-bottom:1rem;"></div>
          )}

          <button type="submit" class="btn btn--rouge devis-form__submit" id="devis-submit">Envoyer ma demande</button>
          <p id="devis-status" role="status" aria-live="polite" class="devis-form__status"></p>
          <p class="devis-form__note">* Champs obligatoires. Vos données servent uniquement à traiter votre demande.</p>
        </form>
      </aside>
    </div>
  </section>

  {turnstileKey && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
  )}
  <script is:inline>
    (function () {
      var loadedAt = Date.now();
      var form = document.getElementById('devis-form');
      if (!form) return;
      var status = document.getElementById('devis-status');
      var submit = document.getElementById('devis-submit');
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        submit.disabled = true;
        status.style.color = '';
        status.textContent = 'Envoi en cours…';
        try {
          var fd = new FormData(form);
          var payload = {};
          fd.forEach(function (v, k) { payload[k] = v; });
          payload.ts = String(loadedAt);
          // La barre finale est obligatoire : le site est en trailingSlash
          // "always", sans elle le POST devient une redirection 301 (donc un
          // GET) et les données sont perdues.
          var res = await fetch('/api/devis/', {
            method: 'POST',
            headers: { 'content-type': 'application/json', accept: 'application/json' },
            body: JSON.stringify(payload),
          });
          var data = await res.json().catch(function () { return {}; });
          if (res.ok && data.ok) {
            window.location.href = '/merci/';
            return;
          }
          status.style.color = '#e4141b';
          status.textContent =
            data.error || "Une erreur est survenue. Merci de réessayer ou de m'appeler.";
          submit.disabled = false;
          if (window.turnstile) window.turnstile.reset();
        } catch (err) {
          status.style.color = '#e4141b';
          status.textContent = "Erreur réseau. Merci de réessayer ou de m'appeler.";
          submit.disabled = false;
          if (window.turnstile) window.turnstile.reset();
        }
      });
    })();
  </script>

  <section class="section section--gris">
    <div class="container">
      <div class="section-head">
        <h2>Notre zone d'intervention en {site.address.region}</h2>
        <p>Installé à {site.address.city}, je me déplace chaque jour dans tout le département : Tours et sa première couronne — Saint-Avertin, Chambray-lès-Tours, La Riche, Saint-Cyr-sur-Loire —, la vallée du Cher et de l'Indre jusqu'à Ballan-Miré, Savonnières, Druye, Veigné, Montbazon et Larçay, ou plus au nord vers Fondettes. Que vous cherchiez un <a href="/couvreur-tours/">couvreur à Tours</a> ou dans un bourg de campagne, la démarche est la même : visite sur place, chiffrage écrit, réponse sous 24 heures.</p>
      </div>
      <div class="devis-map">
        <iframe
          src={mapSrc}
          title={`Carte de la zone d'intervention de ${site.brand}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <p class="devis-map__adresse">{site.address.street} — {site.address.postalCode} {site.address.city}</p>
    </div>
  </section>

  <section class="section">
    <div class="container media-split media-split--reverse media-split--plain">
      <div class="media-split__text">
        <h2>Vous préférez en parler de vive voix ?</h2>
        <p>Certaines questions se règlent en trois minutes de téléphone : savoir si un démoussage suffit encore, si une gouttière se répare ou se remplace, combien de temps immobilise un chantier. Appelez-moi directement — pas de standard, pas de commercial : vous parlez à l'artisan qui montera sur votre toit, et qui rédigera votre devis.</p>
        <p>Je réponds du lundi au samedi, de 8 h à 20 h. En dehors de ces horaires, seules les urgences sont traitées — fuite active, tuiles arrachées par le vent, bâche à poser en attendant la réparation : dans ces cas-là, j'interviens 24 h/24.</p>
        <a class="btn btn--rouge media-split__cta" href={`tel:${site.phoneHref}`}>Appeler le {site.phone}</a>
      </div>
      <div class="media-split__media">
        <img class="devis-appel__photo" src="/photos-chantier/couverture-ardoise-echafaudage-richard-toitures-30-1.webp" width="1200" height="1600" loading="lazy" decoding="async" alt={`Toiture en ardoise refaite avec pose de fenêtres de toit, échafaudage en place — ${site.brand}, couvreur en ${site.address.region}`} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .devis-top { padding-block: 32px 56px; }
  /* Photo du bloc « en parler de vive voix » : portrait (1200x1600) dans un
     cadre 4/3. Le crop centré coupait le faîtage ; on remonte la fenêtre. */
  .devis-appel__photo { object-position: center 40%; }
  @media (max-width: 900px) {
    .devis-top { padding-block: 20px 40px; }
  }
</style>
