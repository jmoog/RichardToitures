---
import Layout from '../layouts/Layout.astro';
import { site, services } from '../data/site.js';

const path = '/merci/';
const title = `Demande envoyée — ${site.brand}`;
const description = 'Votre demande de devis a bien été envoyée. Voici la suite : rappel, visite sur place puis devis détaillé sans engagement.';

// Délais annoncés : volontairement qualitatifs ("rapidement"), cohérents avec
// l'accusé de réception envoyé par /api/devis. Si l'artisan veut s'engager
// sur un délai chiffré (ex. « sous 48 h »), le préciser ici ET dans le
// template `ackTemplate` de src/pages/api/devis.ts pour rester cohérent.
const etapes = [
  {
    titre: 'Un premier échange',
    texte: `${site.founder} vous rappelle rapidement pour préciser votre besoin, répondre à vos premières questions et convenir d'un créneau de visite.`,
  },
  {
    titre: 'La visite sur place',
    texte: `Rendez-vous chez vous pour monter voir la toiture, relever les mesures et identifier ce qui doit réellement être repris. Déplacement gratuit en ${site.address.region}.`,
  },
  {
    titre: 'Le devis détaillé',
    texte: 'Vous recevez un devis écrit, poste par poste, avec les matériaux et la durée du chantier. Sans engagement : rien ne démarre tant que vous ne l’avez pas signé.',
  },
];
---
<Layout title={title} description={description} path={path} noindex={true}>
  <section class="etat">
    <div class="container etat__inner">
      <span class="etat__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.2 5.2L20 7" /></svg>
      </span>
      <h1>Merci, votre demande est bien arrivée</h1>
      <p class="etat__lead">
        {site.founder} a reçu votre demande de devis. Un accusé de réception vient de partir sur votre adresse e-mail —
        s’il n’apparaît pas, pensez à regarder dans vos spams.
      </p>
      <div class="etat__actions">
        <a class="btn btn--rouge btn--lg btn--tel" href={`tel:${site.phoneHref}`}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2z" /></svg>
          Appeler le {site.phone}
        </a>
        <a class="btn btn--lg etat__ghost" href="/">Retour à l’accueil</a>
      </div>
      <p class="etat__note">
        Une fuite en cours, une tuile envolée après un coup de vent ? N’attendez pas le rappel,
        <a href={`tel:${site.phoneHref}`}>appelez directement</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>Et maintenant, comment ça se passe&nbsp;?</h2>
        <p>Trois étapes simples, sans mauvaise surprise et sans engagement de votre part.</p>
      </div>
      <ol class="suite">
        {etapes.map((e) => (
          <li class="suite__item">
            <h3>{e.titre}</h3>
            <p>{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--gris">
    <div class="container">
      <div class="section-head">
        <h2>En attendant, découvrez les prestations</h2>
        <p>Couverture, rénovation, démoussage, isolation&nbsp;: le détail de chaque intervention.</p>
      </div>
      <div class="liens-proches">
        {services.map((s) => <a href={s.href}>{s.label}</a>)}
      </div>
    </div>
  </section>
</Layout>
