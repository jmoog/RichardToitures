---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site.js';

const path = '/merci/';
const title = `Demande envoyée — ${site.brand}`;
const description = 'Votre demande de devis a bien été envoyée.';
---
<Layout title={title} description={description} path={path} noindex={true}>
  <section class="section legal-page">
    <div class="container legal-page__container" style="text-align:center;">
      <h1>Merci, votre demande a bien été envoyée</h1>
      <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. {site.founder} vous recontacte rapidement pour un premier retour, sans engagement.</p>
      <p>Pour une urgence, appelez directement le <a href={`tel:${site.phoneHref}`}>{site.phone}</a>.</p>
      <p><a class="btn btn--rouge" href="/">Retour à l'accueil</a></p>
    </div>
  </section>
</Layout>
