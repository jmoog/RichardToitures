---
const { title, items, gris = true } = Astro.props;
---
<section class={`section${gris ? ' section--gris' : ''}`}>
  <div class="container">
    <div class="section-head section-head--left">
      <h2>{title}</h2>
    </div>
    <div class="faq">
      {items.map((item) => (
        <div class="faq__item">
          <h3>{item.q}</h3>
          <p set:html={item.a} />
        </div>
      ))}
    </div>
  </div>
</section>
